{
  "name": "chara-roguelike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "build:playtest": "PLAYTEST=1 vite build && node scripts/build-single.mjs --out out/playtest.html --title '遠征記（テストプレイ）'",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:html": "node scripts/build-tests.mjs",
    "balance": "esbuild scripts/balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/balance.mjs --log-level=warning && node node_modules/.tmp/balance.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^30.0.1",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
